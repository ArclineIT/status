# Copy to .env and fill in your values. Never commit the real .env.
# Loaded automatically in development and test via dotenv-rails.

# --- Server ---
# Puma reads PORT (default 3000).
PORT=3000
# SQLite database file path (absolute or relative to the app root).
DATABASE_PATH=storage/production.sqlite3

# --- Page ---
STATUS_TITLE=Arcline Status
# Public address of the page, used in the feed.
STATUS_BASE_URL=https://status.arclineit.com

# --- Admin login (HTTP basic auth, required in production) ---
STATUS_USERNAME=admin
STATUS_PASSWORD=
